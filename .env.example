# SciDoc OCR - Environment Variables Template
# Copy this file to .env and fill in your API keys (optional, can also configure in GUI Settings)

# Online AI API Keys
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Default Online Provider ("openai", "google", "anthropic", "opencode")
ONLINE_PROVIDER=google
ONLINE_MODEL=gemini-2.0-flash

# Local AI Engine (LM Studio)
LMSTUDIO_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-9b

# AI Mode: "auto", "local_only", "mineru", "online_only"
AI_MODE=auto

# Translation Engine: "google_translate" (Free & Fast) or "ai_llm"
TRANSLATION_ENGINE=google_translate
